# Inputs of script/DeployZKIdentity.s.sol. No key goes here: sign with
# `--account <name>` (a `cast wallet import` keystore) or a hardware wallet.

# Target EVM network. Name it explicitly; there is no default network.
EVM_RPC_URL=REPLACE_WITH_THE_TARGET_NETWORK_RPC_URL

# First oracle address (a dedicated oracle key, never the owner's).
INITIAL_ORACLE=REPLACE_WITH_ORACLE_ADDRESS

# Block-0 hash of the Demos chain the first epoch tracks, as 0x + 64 hex.
# Read it from the node: nodeCall getChainIdentity -> genesisHash.
DEMOS_GENESIS_HASH=REPLACE_WITH_0x_GENESIS_HASH

# Production owner (Safe behind a timelock). Gets a pending transfer it must
# accept with acceptOwnership(). Leave empty to keep the deployer as owner.
OWNER=

# Target network — pick a preset or use EVM_RPC_URL for a custom endpoint
# Presets: base-sepolia | base-mainnet | eth-mainnet | eth-sepolia | polygon-mainnet | arbitrum-mainnet | local
NETWORK=base-sepolia

# Custom RPC (overrides NETWORK preset when set)
# EVM_RPC_URL=https://your-rpc-endpoint

# Deployer wallet private key (becomes initial oracle address unless ORACLE_ADDRESS is set)
ORACLE_PRIVATE_KEY=REPLACE_WITH_YOUR_64_HEX_CHAR_PRIVATE_KEY

# Optional: set a different address as oracle (defaults to deployer)
# ORACLE_ADDRESS=0x...
